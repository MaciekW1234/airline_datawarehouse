{
	"name": "DF_Bronze_to_Silver_BTS",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_BTS_CSV",
						"type": "DatasetReference"
					},
					"name": "BronzeBTS"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_BTS",
						"type": "DatasetReference"
					},
					"name": "SilverBTS"
				}
			],
			"transformations": [
				{
					"name": "CleanAndStandardize"
				},
				{
					"name": "SelectBTSColumns"
				},
				{
					"name": "AddAudit"
				}
			],
			"scriptLines": [
				"parameters{",
				"     monthFolder as string ('Apr2025')",
				"}",
				"source(output(",
				"          YEAR as short,",
				"          QUARTER as short,",
				"          MONTH as short,",
				"          DAY_OF_MONTH as boolean,",
				"          DAY_OF_WEEK as short,",
				"          FL_DATE as string,",
				"          OP_UNIQUE_CARRIER as string,",
				"          OP_CARRIER_AIRLINE_ID as short,",
				"          OP_CARRIER as string,",
				"          TAIL_NUM as string,",
				"          OP_CARRIER_FL_NUM as short,",
				"          ORIGIN_AIRPORT_ID as short,",
				"          ORIGIN_AIRPORT_SEQ_ID as integer,",
				"          ORIGIN_CITY_MARKET_ID as integer,",
				"          ORIGIN as string,",
				"          ORIGIN_CITY_NAME as string,",
				"          ORIGIN_STATE_ABR as string,",
				"          ORIGIN_STATE_FIPS as short,",
				"          ORIGIN_STATE_NM as string,",
				"          ORIGIN_WAC as short,",
				"          DEST_AIRPORT_ID as short,",
				"          DEST_AIRPORT_SEQ_ID as integer,",
				"          DEST_CITY_MARKET_ID as integer,",
				"          DEST as string,",
				"          DEST_CITY_NAME as string,",
				"          DEST_STATE_ABR as string,",
				"          DEST_STATE_FIPS as short,",
				"          DEST_STATE_NM as string,",
				"          DEST_WAC as short,",
				"          CRS_DEP_TIME as short,",
				"          DEP_TIME as short,",
				"          DEP_DELAY as double,",
				"          DEP_DELAY_NEW as double,",
				"          DEP_DEL15 as double,",
				"          DEP_DELAY_GROUP as short,",
				"          DEP_TIME_BLK as string,",
				"          TAXI_OUT as double,",
				"          WHEELS_OFF as short,",
				"          WHEELS_ON as short,",
				"          TAXI_IN as double,",
				"          CRS_ARR_TIME as short,",
				"          ARR_TIME as short,",
				"          ARR_DELAY as double,",
				"          ARR_DELAY_NEW as double,",
				"          ARR_DEL15 as double,",
				"          ARR_DELAY_GROUP as short,",
				"          ARR_TIME_BLK as string,",
				"          CANCELLED as double,",
				"          CANCELLATION_CODE as string,",
				"          DIVERTED as double,",
				"          CRS_ELAPSED_TIME as double,",
				"          ACTUAL_ELAPSED_TIME as double,",
				"          AIR_TIME as double,",
				"          FLIGHTS as double,",
				"          DISTANCE as double,",
				"          DISTANCE_GROUP as short,",
				"          CARRIER_DELAY as double,",
				"          WEATHER_DELAY as double,",
				"          NAS_DELAY as double,",
				"          SECURITY_DELAY as double,",
				"          LATE_AIRCRAFT_DELAY as double,",
				"          FIRST_DEP_TIME as short,",
				"          TOTAL_ADD_GTIME as double,",
				"          LONGEST_ADD_GTIME as double,",
				"          DIV_AIRPORT_LANDINGS as boolean,",
				"          DIV_REACHED_DEST as double,",
				"          DIV_ACTUAL_ELAPSED_TIME as double,",
				"          DIV_ARR_DELAY as double,",
				"          DIV_DISTANCE as double,",
				"          DIV1_AIRPORT as string,",
				"          DIV1_AIRPORT_ID as short,",
				"          DIV1_AIRPORT_SEQ_ID as integer,",
				"          DIV1_WHEELS_ON as short,",
				"          DIV1_TOTAL_GTIME as double,",
				"          DIV1_LONGEST_GTIME as double,",
				"          DIV1_WHEELS_OFF as short,",
				"          DIV1_TAIL_NUM as string,",
				"          DIV2_AIRPORT as string,",
				"          DIV2_AIRPORT_ID as string,",
				"          DIV2_AIRPORT_SEQ_ID as string,",
				"          DIV2_WHEELS_ON as string,",
				"          DIV2_TOTAL_GTIME as string,",
				"          DIV2_LONGEST_GTIME as string,",
				"          DIV2_WHEELS_OFF as string,",
				"          DIV2_TAIL_NUM as string,",
				"          DIV3_AIRPORT as string,",
				"          DIV3_AIRPORT_ID as string,",
				"          DIV3_AIRPORT_SEQ_ID as string,",
				"          DIV3_WHEELS_ON as string,",
				"          DIV3_TOTAL_GTIME as string,",
				"          DIV3_LONGEST_GTIME as string,",
				"          DIV3_WHEELS_OFF as string,",
				"          DIV3_TAIL_NUM as string,",
				"          DIV4_AIRPORT as string,",
				"          DIV4_AIRPORT_ID as string,",
				"          DIV4_AIRPORT_SEQ_ID as string,",
				"          DIV4_WHEELS_ON as string,",
				"          DIV4_TOTAL_GTIME as string,",
				"          DIV4_LONGEST_GTIME as string,",
				"          DIV4_WHEELS_OFF as string,",
				"          DIV4_TAIL_NUM as string,",
				"          DIV5_AIRPORT as string,",
				"          DIV5_AIRPORT_ID as string,",
				"          DIV5_AIRPORT_SEQ_ID as string,",
				"          DIV5_WHEELS_ON as string,",
				"          DIV5_TOTAL_GTIME as string,",
				"          DIV5_LONGEST_GTIME as string,",
				"          DIV5_WHEELS_OFF as string,",
				"          {{DIV5_TAIL_NUM} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 1000,",
				"     ignoreNoFilesFound: false) ~> BronzeBTS",
				"BronzeBTS derive(OP_UNIQUE_CARRIER = iif(isNull(OP_UNIQUE_CARRIER) || trim(OP_UNIQUE_CARRIER)=='', toString(null()), upper(trim(OP_UNIQUE_CARRIER))),",
				"          OP_CARRIER = iif(isNull(OP_CARRIER) || trim(OP_CARRIER)=='', toString(null()), upper(trim(OP_CARRIER))),",
				"          TAIL_NUM = iif(isNull(TAIL_NUM) || trim(TAIL_NUM)=='', toString(null()), upper(trim(TAIL_NUM))),",
				"          ORIGIN = iif(isNull(ORIGIN) || trim(ORIGIN)=='', toString(null()), upper(trim(ORIGIN))),",
				"          DEST = iif(isNull(DEST) || trim(DEST)=='', toString(null()), upper(trim(DEST))),",
				"          CANCELLATION_CODE = iif(isNull(CANCELLATION_CODE) || trim(CANCELLATION_CODE)=='', toString(null()), upper(trim(CANCELLATION_CODE))),",
				"          FL_DATE = toDate(FL_DATE, 'yyyy-MM-dd'),",
				"          CARRIER_DELAY = iifNull(CARRIER_DELAY, toDouble(0)),",
				"          WEATHER_DELAY = iifNull(WEATHER_DELAY, toDouble(0)),",
				"          NAS_DELAY = iifNull(NAS_DELAY, toDouble(0)),",
				"          SECURITY_DELAY = iifNull(SECURITY_DELAY, toDouble(0)),",
				"          LATE_AIRCRAFT_DELAY = iifNull(LATE_AIRCRAFT_DELAY, toDouble(0))) ~> CleanAndStandardize",
				"CleanAndStandardize select(mapColumn(",
				"          FL_DATE,",
				"          OP_UNIQUE_CARRIER,",
				"          OP_CARRIER_AIRLINE_ID,",
				"          OP_CARRIER,",
				"          TAIL_NUM,",
				"          OP_CARRIER_FL_NUM,",
				"          ORIGIN_AIRPORT_SEQ_ID,",
				"          ORIGIN,",
				"          DEST_AIRPORT_SEQ_ID,",
				"          DEST,",
				"          CRS_DEP_TIME,",
				"          DEP_TIME,",
				"          DEP_DELAY,",
				"          DEP_DELAY_NEW,",
				"          DEP_DEL15,",
				"          CRS_ARR_TIME,",
				"          ARR_TIME,",
				"          ARR_DELAY,",
				"          ARR_DELAY_NEW,",
				"          ARR_DEL15,",
				"          CANCELLED,",
				"          CANCELLATION_CODE,",
				"          DIVERTED,",
				"          FLIGHTS,",
				"          DISTANCE,",
				"          CARRIER_DELAY,",
				"          WEATHER_DELAY,",
				"          NAS_DELAY,",
				"          SECURITY_DELAY,",
				"          LATE_AIRCRAFT_DELAY",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectBTSColumns",
				"SelectBTSColumns derive(Load_Date = currentTimestamp(),",
				"          ETL_Batch_ID = 'BTS_INIT',",
				"          Record_Source = 'BTS') ~> AddAudit",
				"AddAudit sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          FL_DATE as date,",
				"          OP_UNIQUE_CARRIER as string,",
				"          OP_CARRIER_AIRLINE_ID as short,",
				"          OP_CARRIER as string,",
				"          TAIL_NUM as string,",
				"          OP_CARRIER_FL_NUM as short,",
				"          ORIGIN_AIRPORT_SEQ_ID as integer,",
				"          ORIGIN as string,",
				"          DEST_AIRPORT_SEQ_ID as integer,",
				"          DEST as string,",
				"          CRS_DEP_TIME as short,",
				"          DEP_TIME as short,",
				"          DEP_DELAY as double,",
				"          DEP_DELAY_NEW as double,",
				"          DEP_DEL15 as double,",
				"          CRS_ARR_TIME as short,",
				"          ARR_TIME as short,",
				"          ARR_DELAY as double,",
				"          ARR_DELAY_NEW as double,",
				"          ARR_DEL15 as double,",
				"          CANCELLED as double,",
				"          CANCELLATION_CODE as string,",
				"          DIVERTED as double,",
				"          FLIGHTS as double,",
				"          DISTANCE as double,",
				"          CARRIER_DELAY as double,",
				"          WEATHER_DELAY as double,",
				"          NAS_DELAY as double,",
				"          SECURITY_DELAY as double,",
				"          LATE_AIRCRAFT_DELAY as double,",
				"          Load_Date as timestamp,",
				"          ETL_Batch_ID as string,",
				"          Record_Source as string",
				"     ),",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SilverBTS"
			]
		}
	}
}